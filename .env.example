# ---------------------------------------------------------------------------
# Polyglot — copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres 14+ with the `vector` extension available.
# Local:  postgres://polyglot:polyglot@localhost:5432/polyglot
# Neon:   postgres://user:pass@ep-xxx.region.aws.neon.tech/polyglot?sslmode=require
DATABASE_URL=postgres://polyglot:polyglot@localhost:5432/polyglot

# Application role used for all request-scoped queries. This role is NOT the
# owner and does NOT have BYPASSRLS — that is what makes tenant isolation
# structural rather than conventional. See docs/DESIGN.md.
DATABASE_APP_URL=postgres://polyglot_app:polyglot_app@localhost:5432/polyglot

# --- Provider API keys ----------------------------------------------------
# You only need keys for the providers you actually want to call. Adapters
# without a key are reported as "unconfigured" instead of crashing at boot.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Groq and DeepSeek are not configured providers in this build. Both are
# reachable through the same openai-compat adapter: add a `providers` entry in
# packages/config/models.json plus the key here, and no code changes.
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# --- Tools ----------------------------------------------------------------
# get_weather uses Open-Meteo, which needs no key. Left here for swapping in
# a keyed provider later.
OPENWEATHER_API_KEY=

# --- Runtime --------------------------------------------------------------
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Hard ceilings applied per request, before any provider is called.
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
MAX_COST_USD_PER_REQUEST=0.50
REQUEST_TIMEOUT_MS=120000
