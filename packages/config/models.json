{
  "$comment": [
    "Models, capabilities and prices live here, never in code.",
    "",
    "VERIFIED 2026-09-18 against each vendor's published pricing page, with token",
    "limits taken from the providers' own APIs. Sources in docs/PROVIDER_NOTES.md.",
    "",
    "Anthropic cacheWritePerMTok is the 5-minute TTL rate (the default). The",
    "1-hour TTL costs more ($6/MTok on Sonnet 4.6, $2/MTok on Haiku 4.5); we do",
    "not request it, so it is not modelled.",
    "",
    "Scope: Anthropic, Gemini and OpenAI. Groq and DeepSeek also speak the",
    "openai-compat adapter and its tests cover their two quirks, but they are NOT",
    "shipped - enabling either is one entry here plus its API key, no code change."
  ],
  "providers": {
    "anthropic": {
      "adapter": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "baseUrl": "https://api.anthropic.com",
      "extra": {
        "anthropicVersion": "2023-06-01"
      }
    },
    "google": {
      "adapter": "gemini",
      "apiKeyEnv": "GEMINI_API_KEY",
      "baseUrl": "https://generativelanguage.googleapis.com"
    },
    "openai": {
      "adapter": "openai-compat",
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrl": "https://api.openai.com/v1"
    }
  },
  "models": {
    "anthropic:claude-sonnet-4-6": {
      "provider": "anthropic",
      "providerModelId": "claude-sonnet-4-6",
      "displayName": "Claude Sonnet 4.6",
      "contextWindow": 1000000,
      "maxOutputTokens": 128000,
      "capabilities": {
        "tools": true,
        "vision": true,
        "jsonSchema": true,
        "streaming": true
      },
      "pricing": {
        "inputPerMTok": 3.0,
        "outputPerMTok": 15.0,
        "cachedInputPerMTok": 0.3,
        "cacheWritePerMTok": 3.75
      }
    },
    "anthropic:claude-haiku-4-5": {
      "provider": "anthropic",
      "providerModelId": "claude-haiku-4-5",
      "displayName": "Claude Haiku 4.5",
      "contextWindow": 200000,
      "maxOutputTokens": 64000,
      "capabilities": {
        "tools": true,
        "vision": true,
        "jsonSchema": true,
        "streaming": true
      },
      "pricing": {
        "inputPerMTok": 1.0,
        "outputPerMTok": 5.0,
        "cachedInputPerMTok": 0.1,
        "cacheWritePerMTok": 1.25
      }
    },
    "google:gemini-2.5-flash": {
      "provider": "google",
      "providerModelId": "gemini-2.5-flash",
      "displayName": "Gemini 2.5 Flash",
      "contextWindow": 1048576,
      "maxOutputTokens": 65536,
      "capabilities": {
        "tools": true,
        "vision": true,
        "jsonSchema": true,
        "streaming": true
      },
      "pricing": {
        "inputPerMTok": 0.3,
        "outputPerMTok": 2.5,
        "cachedInputPerMTok": 0.03
      }
    },
    "google:gemini-2.5-pro": {
      "provider": "google",
      "providerModelId": "gemini-2.5-pro",
      "displayName": "Gemini 2.5 Pro",
      "contextWindow": 1048576,
      "maxOutputTokens": 65536,
      "capabilities": {
        "tools": true,
        "vision": true,
        "jsonSchema": true,
        "streaming": true
      },
      "pricing": {
        "inputPerMTok": 1.25,
        "outputPerMTok": 10.0,
        "cachedInputPerMTok": 0.125,
        "longContext": {
          "thresholdInputTokens": 200000,
          "inputMultiplier": 2,
          "outputMultiplier": 1.5
        }
      }
    },
    "openai:gpt-5.6-luna": {
      "provider": "openai",
      "providerModelId": "gpt-5.6-luna",
      "displayName": "GPT-5.6 Luna",
      "contextWindow": 1050000,
      "maxOutputTokens": 128000,
      "capabilities": {
        "tools": true,
        "vision": true,
        "jsonSchema": true,
        "streaming": true
      },
      "pricing": {
        "inputPerMTok": 0.2,
        "outputPerMTok": 1.2,
        "cachedInputPerMTok": 0.02,
        "cacheWritePerMTok": 0.25,
        "longContext": {
          "thresholdInputTokens": 272000,
          "inputMultiplier": 2,
          "outputMultiplier": 1.5
        }
      },
      "extra": {
        "$why": "Two verified quirks (checked against the live API 2026-09-18). 1) Rejects max_tokens: 'Use max_completion_tokens instead.' 2) Refuses function tools on /v1/chat/completions unless reasoning_effort is 'none': 'To use function tools, use /v1/responses or set reasoning_effort to none.' The trade-off is no reasoning on tool turns; the alternative is a second adapter for /v1/responses.",
        "maxTokensField": "max_completion_tokens",
        "paramsWhenToolsPresent": {
          "reasoning_effort": "none"
        }
      }
    }
  },
  "embeddingModels": {
    "openai:text-embedding-3-small": {
      "provider": "openai",
      "providerModelId": "text-embedding-3-small",
      "displayName": "OpenAI text-embedding-3-small",
      "dimensions": 1536,
      "pricing": {
        "inputPerMTok": 0.02,
        "outputPerMTok": 0
      }
    },
    "google:text-embedding-004": {
      "provider": "google",
      "providerModelId": "text-embedding-004",
      "displayName": "Gemini text-embedding-004",
      "dimensions": 768,
      "pricing": {
        "inputPerMTok": 0.0,
        "outputPerMTok": 0
      }
    }
  },
  "defaults": {
    "chatModel": "anthropic:claude-haiku-4-5",
    "embeddingModel": "openai:text-embedding-3-small",
    "fallbackChain": [
      "anthropic:claude-haiku-4-5",
      "google:gemini-2.5-flash",
      "openai:gpt-5.6-luna"
    ],
    "retry": {
      "maxAttempts": 3,
      "baseDelayMs": 500,
      "maxDelayMs": 8000,
      "jitter": "full"
    },
    "timeoutMs": 120000,
    "retrieval": {
      "chunkSize": 1000,
      "chunkOverlap": 150,
      "topK": 5,
      "similarityThreshold": 0.35
    }
  }
}
